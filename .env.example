# ========================
# VisionOps Environment Variables
# ========================
# Copy this file to .env and fill in your values

# ---------- PostgreSQL ----------
POSTGRES_USER=visionops
POSTGRES_PASSWORD=visionops_dev
POSTGRES_DB=visionops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://visionops:visionops_dev@localhost:5432/visionops

# ---------- Airflow ----------
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://visionops:visionops_dev@postgres:5432/airflow

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://visionops:visionops_dev@localhost:5432/mlflow
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
